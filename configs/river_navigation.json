  ],
  "sources": {
    "hydroatlas": {
      "url": "https://www.hydrosheds.org/hydroatlas",
      "role": "Modern physical river network and discharge proxies; not historical navigability."
    },
    "etopo": {
      "url": "https://www.ncei.noaa.gov/products/etopo-global-relief-model",
      "role": "Coarse natural gradient proxy; riverbed and individual rapids not resolved."
    },
    "grand_canal_unesco": {
      "url": "https://whc.unesco.org/en/list/1443",
      "role": "Pre-1300 interconnected grain transport canals."
    },
    "grand_canal_icomos": {
      "url": "https://whc.unesco.org/document/128794",
      "role": "Huitong 1289 and Tonghui late thirteenth century; chronology of changing courses."
    },
    "british_canals": {
      "url": "https://www.canalmuseum.org.uk/history/ukcanals.htm",
      "role": "Exeter 1566, later seventeenth/eighteenth-century canal development; do not pre-place industrial networks."
    },
    "thames_history": {
      "url": "https://hbap.pdfsrv.co.uk/customers/HBAP/CQ56690/Vol%2049%202005/1/%E2%80%98The%20Transformation%20of%20the%20Thames%20and%20the%20Port%20of%20London%E2%80%99%20by%20Stephen%20Croad.pdf",
      "role": "Historical port and river access; local fleet abstraction remains a design choice."
    },
    "congo_1911": {
      "url": "https://en.wikisource.org/wiki/1911_Encyclop%C3%A6dia_Britannica/Congo",
      "role": "Pre-major-dam description of natural navigation breaks; not 1300 infrastructure evidence."
    },
    "nile_1911": {
      "url": "https://en.wikisource.org/wiki/1911_Encyclop%C3%A6dia_Britannica/Nile",
      "role": "Cataracts and seasonality; broad natural barrier proxy."
    },
    "victoria_unesco": {
      "url": "https://whc.unesco.org/en/list/509",
      "role": "Natural waterfall barrier."
    },
    "mississippi_nps": {
      "url": "https://www.nps.gov/miss/learn/historyculture/river-of-hisory-chapter-6.htm",
      "role": "Natural Saint Anthony Falls and much later navigation engineering."
    },
    "niagara_nps": {
      "url": "https://www.nps.gov/places/niagara-falls.htm",
      "role": "Natural waterfall barrier, documented by the US National Park Service."
    }
  },
  "native_geometry_overrides": [
    {
      "id": "thames_native_lower_channel",
      "box": [
        7642,
        1740,
        7701,
        1880
      ],
      "state": "improvable",
      "source": "thames_history",
